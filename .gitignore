# Dependencies
node_modules/

# Build output
out/
dist/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# Editor
.vscode/
.idea/

# Downloaded sprites (regenerate with: node scripts/download-sprites.mjs)
src/renderer/public/sprites/

# Issues relay (Cloudflare Worker)
relay/node_modules/
relay/.wrangler/
relay/.dev.vars
relay/.dev.vars.*
!relay/.dev.vars.example
relay/dist/

# Stale emits of electron.vite.config.ts (tsc on tsconfig.node.json, electron-vite temp bundles).
# electron-vite prefers a .js config over the .ts one, so these must never exist.
electron.vite.config.js
electron.vite.config.d.ts
electron.vite.config.*.mjs

# Leftovers from interrupted atomic saves (<file>.tmp.<pid>.<id>)
*.tmp.[0-9]*
